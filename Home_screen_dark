          ],
        ),
      ),

      // মেইন বডি (চ্যাট লিস্ট)
      body: ListView(
        children: [
          _buildChatItem('Family Member 1', 'Hey! How are you?', Icons.person, Colors.blue),
          _buildChatItem('Family Group', 'Audio Call started', Icons.group, Colors.green),
          _buildChatItem('Sister', 'Sent a photo', Icons.image, Colors.orange),
        ],
      ),
      
      // নিচে ডানদিকে কল বাটন
      floatingActionButton: FloatingActionButton(
        backgroundColor: Colors.pink,
        onPressed: () {},
        child: const Icon(Icons.add_ic_call, color: Colors.white),
      ),
    );
