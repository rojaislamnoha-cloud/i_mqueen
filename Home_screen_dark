          children: [
            UserAccountsDrawerHeader(
              accountName: const Text('User Name'),
              accountEmail: const Text('Bio | Country'),
              currentAccountPicture: const CircleAvatar(
                backgroundColor: Colors.white,
                child: Icon(Icons.person, size: 40, color: Colors.pink),
              ),
              decoration: const BoxDecoration(color: Colors.pink),
            ),
            ListTile(
              leading: const Icon(Icons.settings),
              title: const Text('Settings'),
              onTap: () {},
            ),
            ListTile(
              leading: const Icon(Icons.card_giftcard, color: Colors.pink),
              title: const Text('Gift Badge'),
              trailing: const Icon(Icons.star, color: Colors.pink),
              onTap: () {},
            ),
            ListTile(
              leading: const Icon(Icons.call),
              title: const Text('Call History'),
              onTap: () {},
            ),
            const Divider(),
            ListTile(
              leading: const Icon(Icons.group),
              title: const Text('Group Chat/Room'),
              onTap: () {},
            ),
            ListTile(
              leading: const Icon(Icons.person_add),
              title: const Text('Find New Friends'),
              onTap: () {},
            ),
            ListTile(
              leading: const Icon(Icons.live_tv),
              title: const Text('Live Room'),
              onTap: () {},
